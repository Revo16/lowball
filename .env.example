# ---- League ----
# No Shoes Nation
SLEEPER_LEAGUE_ID=1357391451582910464
# Your Sleeper display name. You manage the player pool, confirm payments,
# and pay back whoever places the bet.
ADMIN_SLEEPER_USERNAME=Revo16
# Where every loser sends their $5 (your Venmo, without the @)
PAY_TO_VENMO=
# Optional overrides for the Venmo handles in src/lib/venmos.ts: sleeperUserId=handle,sleeperUserId=handle
VENMOS=
# How much the lowest scorer pays each week
LOSER_AMOUNT=5
# Should the week's loser also pick a leg? "true" or "false"
LOSER_PICKS=true
# Shared passcode your league types once to sign in. Post it in the group chat.
LEAGUE_PIN=

# ---- Secrets ----
# Any long random string: `openssl rand -hex 32`
SESSION_SECRET=
# Vercel sends this as a Bearer token to the cron routes. Any long random string.
CRON_SECRET=

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=
# Use the service_role key. It only ever runs on the server.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Odds ----
# Spreads, totals and moneylines come from ESPN's free feed. Nothing to set.
# Player props: free SportsGameOdds key (https://sportsgameodds.com, no card).
SGO_API_KEY=
# Optional tuning
# SGO_MONTHLY_OBJECTS=2500   # your plan's monthly allowance
# SGO_MIN_REFRESH_MIN=30     # never refresh props faster than this
# ESPN_TTL_MIN=5             # game-line refresh
# Optional paid alternative for props (used only if SGO_API_KEY is empty):
# ODDS_API_KEY=

# ---- Push notifications (the Nudge button + Friday/Saturday reminders) ----
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services, any email of yours
VAPID_SUBJECT=mailto:you@example.com

# ---- Group chat notifications (optional, set one or both) ----
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# GroupMe: https://dev.groupme.com/bots -> Create Bot -> copy the Bot ID
GROUPME_BOT_ID=

# Public URL of the deployed app, used in chat messages
APP_URL=https://your-app.vercel.app
